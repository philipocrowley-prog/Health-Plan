<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Health Tracker">

  <title>Health Tracker</title>

  <link rel="stylesheet" href="styles.css">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>

<body>

  <!-- =====================================================
       LOGIN
  ====================================================== -->

  <div id="loginScreen" class="screen">

    <div class="login-card">

      <div class="app-logo">❤️</div>

      <h1>Health Tracker</h1>

      <p class="subtitle">
        Your personal health dashboard
      </p>

      <form id="loginForm">

        <label for="email">Email</label>

        <input
          type="email"
          id="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        >

        <label for="password">Password</label>

        <input
          type="password"
          id="password"
          placeholder="Password"
          autocomplete="current-password"
          required
        >

        <button type="submit" class="primary-button">
          Sign in
        </button>

      </form>

      <button id="signupButton" class="secondary-button">
        Create account
      </button>

      <p id="authMessage" class="message"></p>

    </div>

  </div>


  <!-- =====================================================
       MAIN APP
  ====================================================== -->

  <div id="appScreen" class="screen hidden">

    <!-- HEADER -->

    <header class="app-header">

      <div>
        <div class="small-label">HEALTH TRACKER</div>
        <h1 id="greeting">Today</h1>
      </div>

      <button id="logoutButton" class="icon-button" title="Sign out">
        ⇥
      </button>

    </header>


    <!-- =================================================
         DASHBOARD
    ================================================== -->

    <main class="container">

      <!-- Today's overview -->

      <section class="section">

        <div class="section-heading">
          <h2>Today's Status</h2>
          <span id="todayDate"></span>
        </div>

        <div class="status-grid">

          <!-- Weight -->

          <div class="status-card">

            <div class="card-icon">⚖️</div>

            <div class="card-title">
              Weight
            </div>

            <div id="latestWeight" class="card-value">
              --
            </div>

            <div id="weightChange" class="card-subvalue">
              --
            </div>

          </div>


          <!-- Blood Pressure -->

          <div class="status-card">

            <div class="card-icon">❤️</div>

            <div class="card-title">
              Blood Pressure
            </div>

            <div id="latestBP" class="card-value">
              --
            </div>

            <div id="latestPulse" class="card-subvalue">
              Pulse --
            </div>

          </div>


          <!-- Leg Symptoms -->

          <div class="status-card">

            <div class="card-icon">🦵</div>

            <div class="card-title">
              Leg Symptoms
            </div>

            <div id="latestPins" class="card-value">
              --
            </div>

            <div id="latestTightness" class="card-subvalue">
              Tightness --
            </div>

          </div>


          <!-- Fasting -->

          <div class="status-card">

            <div class="card-icon">⏱️</div>

            <div class="card-title">
              Fasting
            </div>

            <div id="fastStatus" class="card-value">
              --
            </div>

            <div id="fastDuration" class="card-subvalue">
              --
            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           QUICK ACTIONS
      ================================================== -->

      <section class="section">

        <div class="section-heading">
          <h2>Quick Actions</h2>
        </div>

        <div class="action-grid">

          <button class="action-button" data-action="bp">
            <span>❤️</span>
            <strong>Blood Pressure</strong>
            <small>Log reading</small>
          </button>

          <button class="action-button" data-action="weight">
            <span>⚖️</span>
            <strong>Weight</strong>
            <small>Log weight</small>
          </button>

          <button class="action-button" data-action="symptoms">
            <span>🦵</span>
            <strong>Leg Symptoms</strong>
            <small>Log symptoms</small>
          </button>

          <button class="action-button" data-action="exercise">
            <span>🏋️</span>
            <strong>Exercise</strong>
            <small>Log routine</small>
          </button>

          <button class="action-button" data-action="startFast">
            <span>▶️</span>
            <strong>Start Fast</strong>
            <small>Start now</small>
          </button>

          <button class="action-button" data-action="endFast">
            <span>⏹️</span>
            <strong>End Fast</strong>
            <small>Finish current fast</small>
          </button>

          <button class="action-button" data-action="note">
            <span>📝</span>
            <strong>Add Note</strong>
            <small>Record something</small>
          </button>

        </div>

      </section>


      <!-- =================================================
           EXERCISE
      ================================================== -->

      <section class="section">

        <div class="section-heading">

          <h2>Today's Exercise</h2>

          <span id="exerciseDayType">
            Weekday
          </span>

        </div>

        <div class="exercise-card">

          <label class="check-row">

            <input
              type="checkbox"
              id="morningSquats"
            >

            <span>
              <strong>Morning Squats</strong>
              <small>Prescribed routine</small>
            </span>

          </label>


          <label class="check-row">

            <input
              type="checkbox"
              id="nightExtension"
            >

            <span>
              <strong>Back Extension</strong>
              <small>Lie on stomach, propped on elbows</small>
            </span>

          </label>


          <div class="bonus-area">

            <label for="bonusActivity">
              Weekend / Bonus Activity
            </label>

            <input
              type="text"
              id="bonusActivity"
              placeholder="Walk, golf, stretch, etc."
            >

          </div>


          <button id="saveExercise" class="primary-button">
            Save Exercise
          </button>

        </div>

      </section>


      <!-- =================================================
           7 DAY SUMMARY
      ================================================== -->

      <section class="section">

        <div class="section-heading">
          <h2>7-Day Summary</h2>
        </div>

        <div class="summary-grid">

          <div class="summary-card">
            <span>⚖️</span>
            <strong id="summaryWeight">--</strong>
            <small>Weight change</small>
          </div>

          <div class="summary-card">
            <span>❤️</span>
            <strong id="summaryBP">--</strong>
            <small>Average BP</small>
          </div>

          <div class="summary-card">
            <span>🦵</span>
            <strong id="summaryPins">--</strong>
            <small>Average pins</small>
          </div>

          <div class="summary-card">
            <span>🏋️</span>
            <strong id="summaryExercise">--</strong>
            <small>Weekdays completed</small>
          </div>

          <div class="summary-card">
            <span>⏱️</span>
            <strong id="summaryFasting">--</strong>
            <small>Average fast</small>
          </div>

        </div>

      </section>


      <!-- =================================================
           ALERTS
      ================================================== -->

      <section
        id="symptomAlert"
        class="alert hidden"
      >

        <strong>⚠️ Symptom change</strong>

        <p>
          Your recent symptom entries show a significant change.
          Consider discussing changes or new weakness with your
          GP or healthcare professional.
        </p>

      </section>


      <!-- =================================================
           TRENDS
      ================================================== -->

      <section class="section">

        <div class="section-heading">
          <h2>Progress</h2>
        </div>

        <div class="trend-placeholder">

          <p>
            Your charts will appear here once you have
            enough entries.
          </p>

          <div id="trendStats"></div>

        </div>

      </section>

    </main>


    <!-- =================================================
         MODAL
    ================================================== -->

    <div
      id="modal"
      class="modal hidden"
    >

      <div class="modal-content">

        <button
          id="closeModal"
          class="modal-close"
        >
          ×
        </button>

        <div id="modalBody"></div>

      </div>

    </div>


    <!-- =================================================
         TOAST
    ================================================== -->

    <div
      id="toast"
      class="toast hidden"
    ></div>


    <!-- =================================================
         BOTTOM NAVIGATION
    ================================================== -->

    <nav class="bottom-nav">

      <button
        class="nav-button active"
        data-page="dashboard"
      >
        <span>🏠</span>
        <small>Today</small>
      </button>

      <button
        class="nav-button"
        data-page="history"
      >
        <span>📋</span>
        <small>History</small>
      </button>

      <button
        class="nav-button"
        data-page="progress"
      >
        <span>📈</span>
        <small>Progress</small>
      </button>

    </nav>

  </div>


  <!-- Application JavaScript -->

  <script src="app.js"></script>

</body>
</html>
